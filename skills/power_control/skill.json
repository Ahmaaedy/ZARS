{
  "id": "power_control",
  "desc": "lock, sleep, hibernate, restart, shut down, or cancel a pending power action",
  "params": [
    { "name": "action", "type": "string", "required": true, "desc": "lock, sleep, hibernate, restart, shutdown, or cancel" },
