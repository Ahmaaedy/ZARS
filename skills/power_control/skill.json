  ],
  "keywords": ["lock computer", "sleep computer", "hibernate", "restart computer", "shutdown computer", "cancel shutdown"],
  "examples": ["lock computer", "restart in 30 seconds", "shutdown now", "cancel shutdown", "hibernate"],
