# ZARS environment configuration
#
# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#
# ZARS_MODE:
#   offline  (default) everything local: faster-whisper STT + Ollama reasoning
#   groq                Groq Whisper STT + Groq chat reasoning
#   gemini              Groq Whisper STT + Gemini chat reasoning
#
# In groq/gemini mode the reasoning providers fail over to EACH OTHER before
# falling back to the local Ollama model. STT is always Groq in both online
# modes (Gemini is reasoning-only here). Wake word, VAD and TTS stay local
# everywhere, and nothing is sent while idle.
# Any other value logs a warning and falls back to offline.
ZARS_MODE=offline

# Required only when ZARS_MODE=online. Without it ZARS logs an error and runs offline.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model IDs. These change often -- verify against
# https://console.groq.com/docs/models before changing.
# Speech-to-text options: whisper-large-v3-turbo (fast, cheap) | whisper-large-v3 (most accurate)
GROQ_STT_MODEL=whisper-large-v3-turbo
# Chat models: llama-3.3-70b-versatile | openai/gpt-oss-20b | openai/gpt-oss-120b | llama-3.1-8b-instant
GROQ_LLM_MODEL=openai/gpt-oss-20b

# Language hint sent with the audio. Set to an empty value to auto-detect.
GROQ_STT_LANGUAGE=en

# Per-request timeout in seconds.
GROQ_TIMEOUT_SECONDS=15

# On a 429 (rate limit), honour Retry-After for at most this many seconds and
# retry once. Longer waits fail over to the local stack instead, so voice
# never stalls. Set to 0 to fail over immediately on any 429.
GROQ_RETRY_AFTER_MAX_S=2

# If Groq fails (network, 401, 429, 5xx), fall back to the local stack for that
# request. true = degrade gracefully; false = speak an error and return to IDLE.
ONLINE_FALLBACK_TO_LOCAL=true

# --- Gemini (Google AI Studio): reasoning only, used when ZARS_MODE=gemini ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model id. Flash-Lite is the cheap/fast tier. Verify what your key can
# actually reach with:  python test_gemini.py models
# Options have included gemini-2.5-flash-lite, gemini-3.1-flash-lite, and the
# gemini-flash-lite-latest alias (recommended: it survives retirements).
GEMINI_LLM_MODEL=gemini-flash-lite-latest

# Gemini is slower than Groq for reasoning, so it gets its own timeout.
GEMINI_TIMEOUT_SECONDS=30
# Same Retry-After policy as Groq: wait at most this long, retry once.
GEMINI_RETRY_AFTER_MAX_S=2

# --- unrelated keys already in use ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=