# ZARS environment configuration
#
# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#
# ZARS_MODE:
#   offline  (default) everything local: faster-whisper STT + Ollama reasoning
#   groq                Groq Whisper STT + Groq chat reasoning
#   gemini              Groq Whisper STT + Gemini chat reasoning
#
# In groq/gemini mode the reasoning providers fail over to EACH OTHER before
# falling back to the local Ollama model. STT is always Groq in both online
# modes (Gemini is reasoning-only here). Wake word, VAD and TTS stay local
# everywhere, and nothing is sent while idle.
# Any other value logs a warning and falls back to offline.
# --- wake chime ---
# Played the moment the wake word fires, before the listen window opens, so you
# know it was heard. Drop any audio file named `wakeup.mp3` into the project root
# and it is used automatically -- no setting required. Nothing here is
# required: a missing, unreadable, or silent file is reported once and then
# ignored, because a chime must never be the reason voice mode fails to start.
#
# ZARS_VOICE_WAKE_CHIME      bare filename -> resolved against the project root.
#                             mp3 and wav both work; empty disables the chime.
# ZARS_VOICE_WAKE_CHIME_GAIN 0..1, the peak the file is normalised to on load, so
#                             any drop-in plays at the same level regardless of
#                             how it was mastered

ZARS_MODE=offline

# Required only when ZARS_MODE=online. Without it ZARS logs an error and runs offline.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model IDs. These change often -- verify against
# https://console.groq.com/docs/models before changing.
# Speech-to-text options: whisper-large-v3-turbo (fast, cheap) | whisper-large-v3 (most accurate)
GROQ_STT_MODEL=whisper-large-v3-turbo
# Chat models: llama-3.3-70b-versatile | openai/gpt-oss-20b | openai/gpt-oss-120b | llama-3.1-8b-instant
GROQ_LLM_MODEL=openai/gpt-oss-20b

# Language hint sent with the audio. Set to an empty value to auto-detect.
GROQ_STT_LANGUAGE=en

# Per-request timeout in seconds.
GROQ_TIMEOUT_SECONDS=15

# Reasoning-request shaping. These are separate from config.json's shared
# `temperature` on purpose: config.json's value is tuned for the local Ollama
# model and Groq wants a different range.
#
# GROQ_TEMPERATURE: Groq documents gpt-oss as best at 0.5-0.7 (server default
#   0.6). Sampling at 1.0 makes malformed tool-call syntax more likely, which
#   surfaces as "Parsing failed. The model generated output that could not be
#   parsed." Use 1.0-2.0 only for creative prose.
GROQ_TEMPERATURE=0.6
#
# GROQ_MAX_COMPLETION_TOKENS: Groq's server default is 1024 tokens for the
#   WHOLE response, and a reasoning model spends most of that before it emits
#   the tool call. Too small a ceiling truncates the arguments mid-JSON, which
#   Groq reports as a parse failure. 2048 is comfortable for one-shot tool
#   picks; raise it if you use ZARS for long reasoning chains.
GROQ_MAX_COMPLETION_TOKENS=2048
#
# GROQ_REASONING_EFFORT: low | medium | high, on gpt-oss only (ignored for
#   other Groq models, which reject the parameter). ZARS asks for one small
#   action per turn, so deep reasoning is mostly wasted budget. Raise to medium
#   if you want the model to think harder before non-trivial PowerShell commands.
GROQ_REASONING_EFFORT=low

# On a 429 (rate limit), honour Retry-After for at most this many seconds and
# retry once. Longer waits fail over to the local stack instead, so voice
# never stalls. Set to 0 to fail over immediately on any 429.
GROQ_RETRY_AFTER_MAX_S=2

# If Groq fails (network, 401, 429, 5xx), fall back to the local stack for that
# request. true = degrade gracefully; false = speak an error and return to IDLE.
ONLINE_FALLBACK_TO_LOCAL=true

# --- Gemini (Google AI Studio): reasoning only, used when ZARS_MODE=gemini ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model id. Flash-Lite is the cheap/fast tier. Verify what your key can
# actually reach with:  python test_gemini.py models
# Options have included gemini-2.5-flash-lite, gemini-3.1-flash-lite, and the
# gemini-flash-lite-latest alias (recommended: it survives retirements).
GEMINI_LLM_MODEL=gemini-flash-lite-latest

# Gemini is slower than Groq for reasoning, so it gets its own timeout.
GEMINI_TIMEOUT_SECONDS=30
# Same Retry-After policy as Groq: wait at most this long, retry once.
GEMINI_RETRY_AFTER_MAX_S=2

# --- unrelated keys already in use ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- ollama server autostart ---
# Zars talks to Ollama over HTTP but never used to start it, so on a machine
# where it is not already running every reasoning call failed with a connection
# error. It now probes first, runs `ollama serve` if nothing answers, and waits
# for it to come up. In offline mode this happens at startup; in groq/gemini
# mode it only happens if the last-resort local fallback is actually reached.
#
# If the configured model has never been pulled, Zars prints the exact
# `ollama pull` command rather than failing later with an opaque 404.
#
# ZARS_OLLAMA_AUTOSTART=false disables this entirely.
# ZARS_OLLAMA_AUTOSTART_WAIT_S is how long to wait for a cold start. Measured on
# this machine: ~4s cold, ~10s to restart a server that had a model loaded.
# Restarting mid-request gets at least 45s regardless, since the alternative is
# failing the request outright.
#
# Only a loopback host is ever started, and only a server Zars itself launched
# is ever stopped on exit -- an Ollama you were already running, or that runs as
# a Windows service, is left alone.

# --- orb speech caption (voice mode only, see animations/orb_overlay.py) ---
# The translucent bubble above the orb that writes what Zars is saying. Voice
# mode only; ignored everywhere else. Needs --voice and PyQt5.
#
# ZARS_ORB_CAPTION=false turns the bubble off entirely, leaving the bare orb.
# ZARS_ORB_CAPTION_MODE:
#   typewriter (default) words appear one by one, paced against the real audio
#                 length so the last word lands when the audio ends
#   instant                 each whole sentence appears the moment it starts
# ZARS_ORB_CAPTION_WIDTH is the bubble width in px. It extends to the right from
# the orb, which stays anchored bottom-left, so the orb never moves.
# ZARS_ORB_CAPTION_MAX_LINES caps the height. A longer sentence is truncated with
# an ellipsis rather than growing the bubble.
ZARS_ORB_CAPTION=true
ZARS_ORB_CAPTION_MODE=typewriter
ZARS_ORB_CAPTION_WIDTH=360
ZARS_ORB_CAPTION_MAX_LINES=4
ZARS_ORB_CAPTION_FADE_MS=400

ZARS_OLLAMA_AUTOSTART=true
ZARS_OLLAMA_AUTOSTART_WAIT_S=20.0

# --- voice sleep/wake policy (`python main.py --voice`) ---
# She only answers when called. The wake word is the only way in; after one
# request she goes dormant and ignores everything -- including further wake
# words -- until the refractory window elapses.
#
# The microphone is never closed, because a closed mic cannot hear a wake word.
# While asleep, frames are read and discarded: nothing is buffered, recorded, or
# sent to the VAD, STT or LLM. Set ALWAYS_ASLEEP=false for the old behaviour of
# staying hot and ready to re-trigger the moment she stops talking.
#
# ZARS_VOICE_SLEEP_AFTER_ANSWER_S is how long she sleeps after finishing an
# answer. Raise it if background noise is waking her; lower it if you wait too
# long to ask the next thing. This is deliberately separate from the TTS
# self-echo suppression, which stays on voice_cooldown_s in config.json.
#
# ZARS_VOICE_WAKEWORD_THRESHOLD is how easily the word trips. Lower = more
# sensitive but more false wakes ("hey" in a conversation). 0.5 is the shipped
# default; config.json currently overrides it to 0.19, which is very sensitive.
# ZARS_VOICE_WAKE_REARM_RATIO is the hysteresis floor: after firing, the score
# must fall below threshold * ratio before another wake can arm, so one spoken
# phrase can only wake her once. Clamped to 0.2..0.95 -- too high and she never
# re-arms, too low and the floor sits below ordinary speech.
# ZARS_VOICE_WAKE_MAX_LOCK_S caps how long one phrase can hold the detector
# regardless. This is the safety valve: without it, a pause shorter than the
# cooldown would leave her locked for the rest of the session.
# ZARS_VOICE_WAKE_COOLDOWN_S is a hard floor on the gap between two wakes.
#
# The listen window itself: after the wake word she records until the VAD sees
# silence, capped by MAX_RECORD_S, and gives up after NO_SPEECH_TIMEOUT_S of you
# not saying anything.
ZARS_VOICE_ALWAYS_ASLEEP=true
ZARS_VOICE_SLEEP_AFTER_ANSWER_S=3.0
ZARS_VOICE_WAKEWORD_THRESHOLD=0.5
ZARS_VOICE_WAKE_REARM_RATIO=0.6
ZARS_VOICE_WAKE_MAX_LOCK_S=5.0
ZARS_VOICE_WAKE_COOLDOWN_S=2.0
ZARS_VOICE_NO_SPEECH_TIMEOUT_S=6.0
ZARS_VOICE_MAX_RECORD_S=30.0