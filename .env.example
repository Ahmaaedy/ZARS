# ZARS environment configuration
#
# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#
# ZARS_MODE:
#   offline  (default) everything local: faster-whisper STT + Ollama reasoning
#   online               Groq for STT + reasoning; wake word, VAD and TTS stay local
#   Any other value logs a warning and falls back to offline.
ZARS_MODE=offline

# Required only when ZARS_MODE=online. Without it ZARS logs an error and runs offline.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model IDs. These change often -- verify against
# https://console.groq.com/docs/models before changing.
# Speech-to-text options: whisper-large-v3-turbo (fast, cheap) | whisper-large-v3 (most accurate)
GROQ_STT_MODEL=whisper-large-v3-turbo
# Chat models: llama-3.3-70b-versatile | openai/gpt-oss-20b | openai/gpt-oss-120b | llama-3.1-8b-instant
GROQ_LLM_MODEL=openai/gpt-oss-20b

# Language hint sent with the audio. Set to an empty value to auto-detect.
GROQ_STT_LANGUAGE=en

# Per-request timeout in seconds.
GROQ_TIMEOUT_SECONDS=15

# If Groq fails (network, 401, 429, 5xx), fall back to the local stack for that
# request. true = degrade gracefully; false = speak an error and return to IDLE.
ONLINE_FALLBACK_TO_LOCAL=true

# --- unrelated keys already in use ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=